<Application x:Class="UsageMon.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#151B24" />
        <SolidColorBrush x:Key="Muted" Color="#9AA9BA" />
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202A37" />
            <Setter Property="Foreground" Value="#F0F4F8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#344256" />
            <Setter Property="MaxWidth" Value="480" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#202A37" />
            <Setter Property="Foreground" Value="#F0F4F8" />
            <Setter Property="BorderBrush" Value="#344256" />
        </Style>
    </Application.Resources>
</Application>
