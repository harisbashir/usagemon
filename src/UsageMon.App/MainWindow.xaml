<Window x:Class="UsageMon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMon" Width="520" Height="48"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Background="{StaticResource Surface}" Foreground="#F0F4F8"
        FontFamily="Segoe UI" FontSize="10" UseLayoutRounding="True"
        SnapsToDevicePixels="True" MouseLeftButtonDown="DragWidget"
        ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
    <Window.Resources>
        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#283443" />
            <Setter Property="Foreground" Value="#356A60" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <DataTemplate x:Key="ProviderTemplate">
            <Grid ToolTip="{Binding Tooltip}" Margin="6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{Binding StatusBrush}" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="8" MaxWidth="35" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="5h" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="7d" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding FiveValue, Mode=OneWay}" Foreground="{Binding FiveBrush}" AutomationProperties.Name="Five-hour allowance used" />
                    <TextBlock Text="{Binding FivePercent}" Style="{StaticResource BarText}" />
                </Grid>
                <Grid Grid.Column="2" Grid.Row="1" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding WeekValue, Mode=OneWay}" Foreground="{Binding WeekBrush}" AutomationProperties.Name="Weekly allowance used" />
                    <TextBlock Text="{Binding WeekPercent}" Style="{StaticResource BarText}" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding FiveReset}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding WeekReset}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
    <Border Width="520" Height="48" BorderThickness="1" BorderBrush="#344256">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="⠿" FontSize="16" Foreground="#678197" HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="Drag to move · Right-click for controls" AutomationProperties.Name="Drag widget" />
            <ContentControl Grid.Column="1" Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderTemplate}" />
            <Border Grid.Column="2" Background="#344256" Margin="0,8" />
            <ContentControl Grid.Column="3" Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderTemplate}" />
            <Border Grid.Column="4" Background="#344256" Margin="0,8" />
            <Grid Grid.Column="5" Margin="10,3" ToolTip="System-wide CPU utilization and physical RAM in use. Samples every two seconds.">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <TextBlock Text="CPU" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="RAM" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding CpuValue, Mode=OneWay}" AutomationProperties.Name="CPU utilization" />
                    <TextBlock Text="{Binding Cpu}" Style="{StaticResource BarText}" />
                </Grid>
                <Grid Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding RamValue, Mode=OneWay}" AutomationProperties.Name="Physical RAM in use" />
                    <TextBlock Text="{Binding Ram}" Style="{StaticResource BarText}" />
                </Grid>
            </Grid>
            <Button Grid.Column="6" Content="⋮" FontSize="18" Foreground="#A9BACB" Background="Transparent" BorderThickness="0"
                    Click="OpenMenu" ToolTip="Widget controls" AutomationProperties.Name="Widget controls" />
        </Grid>
    </Border>
    </Viewbox>
</Window>
