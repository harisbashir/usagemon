<Window x:Class="UsageMon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMon" Width="650" Height="48"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Background="{StaticResource Surface}" Foreground="#F0F4F8"
        FontFamily="Segoe UI" FontSize="11" UseLayoutRounding="True"
        SnapsToDevicePixels="True" MouseLeftButtonDown="DragWidget"
        ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
    <Window.Resources>
        <DataTemplate x:Key="ProviderTemplate">
            <Grid ToolTip="{Binding Tooltip}" Margin="10,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="23" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="9" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="5h" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="7d" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding FivePercent}" Foreground="{Binding FiveBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding WeekPercent}" Foreground="{Binding WeekBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding FiveReset}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding WeekReset}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
    <Border Width="650" Height="48" BorderThickness="1" BorderBrush="#344256">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="⠿" FontSize="18" Foreground="#678197" HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="Drag to move · Right-click for controls" AutomationProperties.Name="Drag widget" />
            <ContentControl Grid.Column="1" Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderTemplate}" />
            <Border Grid.Column="2" Background="#344256" Margin="0,8" />
            <ContentControl Grid.Column="3" Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderTemplate}" />
            <Border Grid.Column="4" Background="#344256" Margin="0,8" />
            <Grid Grid.Column="5" Margin="12,3" ToolTip="System-wide CPU utilization and physical RAM in use. Samples every two seconds.">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <TextBlock Text="CPU" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="RAM" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Cpu}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Ram}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Button Grid.Column="6" Content="⋮" FontSize="18" Foreground="#A9BACB" Background="Transparent" BorderThickness="0"
                    Click="OpenMenu" ToolTip="Widget controls" AutomationProperties.Name="Widget controls" />
        </Grid>
    </Border>
    </Viewbox>
</Window>
